<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.objwww.pr</groupId>
        <artifactId>pr-agent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>control-app</artifactId>
    <name>control-app</name>
    <description>Control 进程：写凭证零接触。Flyway 迁移在本模块以 owner 数据源执行。</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- EN-06 spike：MCP SDK 2.0.0 声明 reactor-core 3.7.0（本地仓无此精确版），
                 钉到本地在库 3.7.x 同线补丁版——偏差记执行日志 spike 记录 -->
            <dependency>
                <groupId>io.projectreactor</groupId>
                <artifactId>reactor-core</artifactId>
                <version>3.7.5</version>
            </dependency>
            <!-- EN-06 spike：mcp-json-jackson3（Jackson 3）运行期要求 annotations 2.20
                 新方法（JsonProperty.isRequired()）；Boot 3.4.5 管理版本过低 → 钉 2.20
                 （annotations 对 2.x databind 向后兼容） -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>2.20</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.objwww.pr</groupId>
            <artifactId>shared-kernel</artifactId>
        </dependency>

        <!-- EN-06：MCP 官方 Java SDK（io.modelcontextprotocol.sdk:mcp 2.0.0，
             聚合 mcp-core + mcp-json-jackson3；spike 记录见 EN 执行日志 §十） -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>2.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JDBC：SequenceAllocator/账本 Repository 的 Postgres 实现（M0-T03/T04） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- 驱动为 compile 可见（M5-19：归档 COPY 导出经 PGConnection#getCopyAPI，
             耦合面收口在 PostgresPartitionArchiveGateway 单类） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- OpenAI 兼容端点适配（百炼等）；M0-T07 才写适配代码，先放依赖 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Flyway 迁移在 control-app（owner 数据源，后续任务接） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- M3-28：actuator + Micrometer 最小指标（暴露面在 application.yml 收口为
             health,info,metrics；禁高基数 ID label 由 AlertMetrics label allowlist 测试钉死） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 监控页 run_throughput 实源（2026-09-14）：Prometheus 拉取面 /actuator/prometheus；
             OTEL_EXPORTER_OTLP_ENDPOINT 仅是声明面（类路径无 OTLP 依赖，实测 otelcol-control
             9465 零指标），rca_attempt_finished_total 经本 registry 暴露给 AM0 抓取 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- M3-29：tracing API + brave 桥（无 exporter 时 span 仅内存态；异步边界
             关联由 TracedTasks + 测试钉死，OTel collector 上线后零改动接通） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <!-- PA-A6（L8-6）：Zipkin 格式 span 导出（→ otelcol-control zipkin receiver，
             tail_sampling 后转 OTLP 上游）；endpoint 走 docker profile env（置空可显式
             关闭导出）。Boot BOM 经 zipkin-reporter-bom 管版本（3.4.3，零显式版本钉）。
             分层纪律：incident_id/run_id/attempt_id 作 attribute，trace_id/span_id 由
             Tracer 生成，不拿业务 ID 伪造。 -->
        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>

        <!-- EX-C3a：认证最小闭环——Spring Security 6 服务端会话（浏览器）+ 机器静态 bearer
             过滤器；禁自建 token 表+HMAC（卡面机制裁定见执行日志） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!--
                  classifier=exec：主 artifact 保持瘦 jar——publisher-app 的集成测试
                  （test 依赖本模块主代码）在 verify 反应堆中经包路径解析；若主 artifact
                  被 repackage 覆盖成胖 jar（BOOT-INF/ 布局），下游 test-compile 会
                  找不到类。可运行胖 jar 以 *-exec.jar 名义照常产出（T18 部署用它）。
                -->
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
