<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.objwww.pr</groupId>
        <artifactId>pr-agent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>publisher-app</artifactId>
    <name>publisher-app</name>
    <description>Publisher 进程：独占 GitHub 写凭证，唯一写出口。</description>

    <dependencies>
        <dependency>
            <groupId>com.objwww.pr</groupId>
            <artifactId>shared-kernel</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JDBC：outbox PG 实现（T11/T13）；默认 profile 排除 DataSource 自动配置，空跑不破 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          仅测试域：T17 集成测试（it 包）在单 JVM 内同驱 Control 真实 Worker/T2 与
          Publisher 真实 Claimer/Executor（同一 PG、同一 CAS），故测试依赖 control-app
          主代码。反向（control 测 publisher）不可行：二者会形成反应堆循环依赖。
          代价：control 主代码把 spring-ai-starter-model-openai 拖进本模块测试
          classpath，其自动配置要求 API key——由 src/test/resources/application.yml
          注入占位 key 解决（测试资源不进生产 jar，默认 profile 空跑语义不变）。
        -->
        <dependency>
            <groupId>com.objwww.pr</groupId>
            <artifactId>control-app</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 集成测试基建用 Flyway 在 Testcontainers PG 上执行 V1+V2（test scope） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
