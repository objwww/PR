# duty-adapter 127 侧环境（cp .env.example .env 后填真值；真值文件不进仓库）
# 与两侧对齐：DUTY_SNAPSHOT_BEARER = 195 deploy/.env 的 APP_OPERATOR_API_BEARER
#            DUTY_WRITEBACK_BEARER = 195 deploy/.env 的 APP_DUTY_ADAPTER_BEARER
#            DUTY_ADAPTER_TOKEN    = 127 gatus .env 的 DUTY_ADAPTER_TOKEN（gatus-config.yml 头注入用）
DUTY_ADAPTER_TOKEN=change-me-gatus-to-adapter
DUTY_SNAPSHOT_BEARER=change-me-same-as-195-app-operator-api-bearer
DUTY_WRITEBACK_BEARER=change-me-same-as-195-app-duty-adapter-bearer
# 可选覆盖（默认走 WG 隧道窄代理）
#DUTY_SNAPSHOT_URL=http://10.250.250.1:8090/api/duty/schedule/snapshot
#DUTY_WRITEBACK_URL=http://10.250.250.1:8090/api/duty/notifications

# 通道 webhook 值（值不进任何库/快照；duty_channel 表只存下面这些键名）：
#   duty_channel.env_key_webhook 填 K_DUTY_<名>_WEBHOOK → 此处同键名给值
#   duty_channel.env_key_secret  填 K_DUTY_<名>_SECRET（钉钉加签；企微留空）
# 示例：
#K_DUTY_PRIMARY_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_key=xxx
#K_DUTY_PRIMARY_SECRET=SECxxx
#K_DUTY_FALLBACK_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
