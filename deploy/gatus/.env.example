# M5-17 Gatus 外部探针 env 契约（2C4G 部署段）——真值只进 2C4G .env，零入库零入文档
# 部署段流程：cp .env.example .env && 填真值 && docker compose -f compose.gatus.yml up -d

# 独立值班通道 webhook（直达值班接收器；红线：不是本系统 /webhooks/alertmanager）
GATUS_ONCALL_WEBHOOK_URL=

# 黑盒探针目标（195 侧地址；195 control endpoint 挂时 Gatus 阈值内独立告警）
CONTROL_HEALTH_URL=
ALERTMANAGER_HEALTH_URL=

# 合成 canary（业务面）
ARENA_HEALTH_URL=
