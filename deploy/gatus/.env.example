# M5-17 Gatus 外部探针 env 契约（2C4G 部署段）——真值只进 2C4G .env，零入库零入文档
# 部署段流程：cp .env.example .env && 填真值 && docker compose -f compose.gatus.yml up -d

# 独立值班通道 webhook（直达值班接收器；红线：不是本系统 /webhooks/alertmanager）
# M7-17 起指向 127 本机 duty-adapter（隧道地址；公网零暴露）
GATUS_ONCALL_WEBHOOK_URL=http://10.250.250.2:8090/hook/gatus

# duty-adapter 验签（与 127 deploy/duty-adapter/.env 的 DUTY_ADAPTER_TOKEN 同值；
# gatus-config.yml headers Authorization 经 os.ExpandEnv 注入）
DUTY_ADAPTER_TOKEN=

# 黑盒探针目标（全部经 195 窄反代精确 GET 路径——195 三目标 loopback 绑定，
# MIG-01 负向验收实证隧道无直连面；负向：经隧道打 /api/rca-runs 必须 404）
CONTROL_HEALTH_URL=http://10.250.250.1:8090/probe/control-health
ALERTMANAGER_HEALTH_URL=http://10.250.250.1:8090/probe/am-ready

# 合成 canary（业务面）
ARENA_HEALTH_URL=http://10.250.250.1:8090/probe/arena

# EX-C4：M7 值班链黑盒（快照端点 op 线 bearer 与 127 duty-adapter DUTY_SNAPSHOT_BEARER 同值）
DUTY_CHAIN_SNAPSHOT_URL=http://10.250.250.1:8090/api/duty/schedule/snapshot
DUTY_SNAPSHOT_BEARER=

# EX-C4：adapter 自身 /health（127 本机；§8.4 自指死锁承诺边界已登记）
DUTY_ADAPTER_HEALTH_URL=http://10.250.250.2:8090/health
