{
  "mappings": [
    {
      "name": "mint-installation-token",
      "request": { "method": "POST", "urlPathPattern": "/app/installations/\\d+/access_tokens" },
      "response": {
        "status": 201,
        "jsonBody": { "token": "stub-installation-token", "expires_at": "2099-01-01T00:00:00Z" }
      }
    },
    {
      "name": "tarball",
      "request": { "method": "GET", "urlPathPattern": "/repos/[^/]+/[^/]+/tarball/[^/]+" },
      "response": {
        "status": 200,
        "bodyFileName": "stub-tarball.tar.gz",
        "headers": { "Content-Type": "application/octet-stream" }
      }
    },
    {
      "name": "compare-diff",
      "request": { "method": "GET", "urlPathPattern": "/repos/[^/]+/[^/]+/compare/.+" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "text/plain; charset=utf-8" },
        "body": "diff --git a/src/Main.java b/src/Main.java\nindex 0000000..1111111 100644\n--- a/src/Main.java\n+++ b/src/Main.java\n@@ -1,5 +1,6 @@\n public class Main {\n     public static void main(String[] args) {\n+        System.out.println(\"hello stub v2\");\n         System.out.println(\"hello stub\");\n     }\n }\n"
      }
    },
    {
      "name": "create-check-run",
      "request": { "method": "POST", "urlPathPattern": "/repos/[^/]+/[^/]+/check-runs" },
      "response": {
        "status": 201,
        "transformers": ["response-template"],
        "headers": { "Content-Type": "application/json" },
        "body": "{\"id\": {{#assign 'cid'}}{{randomInt lower=7200000 upper=7499999}}{{/assign}}{{cid}}, \"html_url\": \"http://stub.local/check-runs/{{cid}}\", \"status\": \"completed\"}"
      }
    },
    {
      "name": "update-check-run",
      "request": { "method": "PATCH", "urlPathPattern": "/repos/[^/]+/[^/]+/check-runs/\\d+" },
      "response": {
        "status": 200,
        "jsonBody": { "id": 7000001, "html_url": "http://stub.local/check-runs/7000001" }
      }
    },
    {
      "name": "create-review",
      "request": { "method": "POST", "urlPathPattern": "/repos/[^/]+/[^/]+/pulls/\\d+/reviews" },
      "response": {
        "status": 200,
        "transformers": ["response-template"],
        "headers": { "Content-Type": "application/json" },
        "body": "{\"id\": {{#assign 'rid'}}{{randomInt lower=8100000 upper=8999999}}{{/assign}}{{rid}}, \"html_url\": \"http://stub.local/reviews/{{rid}}\"}"
      }
    },
    {
      "name": "probe-list-checks-for-sha",
      "request": { "method": "GET", "urlPathPattern": "/repos/[^/]+/[^/]+/commits/[^/]+/check-runs" },
      "response": { "status": 200, "jsonBody": { "check_runs": [] } }
    },
    {
      "name": "probe-get-check-run",
      "request": { "method": "GET", "urlPathPattern": "/repos/[^/]+/[^/]+/check-runs/\\d+" },
      "response": {
        "status": 200,
        "jsonBody": { "id": 7000001, "external_id": "", "html_url": "http://stub.local/check-runs/7000001" }
      }
    },
    {
      "name": "probe-list-reviews",
      "request": { "method": "GET", "urlPathPattern": "/repos/[^/]+/[^/]+/pulls/\\d+/reviews" },
      "response": { "status": 200, "jsonBody": [] }
    },
    {
      "name": "get-pr-metadata（M1 权威读；head/base 固定值与 smoke-test.sh DP-05 负载一致）",
      "request": { "method": "GET", "urlPathPattern": "/repos/[^/]+/[^/]+/pulls/\\d+" },
      "response": {
        "status": 200,
        "jsonBody": {
          "number": 7, "state": "open", "draft": false, "merged": false,
          "head": { "sha": "deadbeefcccccccccccccccccccccccccccccccc", "ref": "feature-stub" },
          "base": { "ref": "main", "sha": "cafe0000bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" },
          "updated_at": "2026-01-01T00:00:00Z"
        }
      }
    },
    {
      "name": "get-repo-sanity（M1 sanity 读：DriftReconciler MISSING 复核 / PrStateReconciler 404 甄别）",
      "request": { "method": "GET", "urlPathPattern": "/repos/[^/]+/[^/]+" },
      "response": {
        "status": 200,
        "jsonBody": { "id": 9001, "full_name": "stuborg/stubrepo", "private": false }
      }
    },
    {
      "name": "model-chat-completions（OPENAI_COMPAT_BASE_URL 指 github-stub 时启用；固定回 1 条 finding，existing_code 逐字锚定 __files/stub-tarball.tar.gz 的 src/Main.java）",
      "request": { "method": "POST", "urlPathPattern": ".*/chat/completions" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "id": "chatcmpl-stub",
          "object": "chat.completion",
          "created": 0,
          "model": "stub",
          "choices": [
            { "index": 0, "message": { "role": "assistant", "content": "[{\"file\":\"src/Main.java\",\"line\":1,\"existing_code\":\"System.out.println(\\\"hello stub\\\");\",\"rule\":\"smoke-stub\",\"severity\":\"INFO\",\"message\":\"stub 固定发现（DP-05 冒烟）\"}]" }, "finish_reason": "stop" }
          ],
          "usage": { "prompt_tokens": 100, "completion_tokens": 50, "total_tokens": 150 }
        }
      }
    }
  ]
}
