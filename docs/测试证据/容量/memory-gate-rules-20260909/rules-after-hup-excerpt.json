{
    "name":  "memory-gate",
    "file":  "/etc/prometheus/rules/memory-gate.yml",
    "rules":  [
                  {
                      "state":  "inactive",
                      "name":  "MemoryGateTier1",
                      "query":  "node_memory_MemAvailable_bytes{job=\"node-exporter-host1\"} \u003c 1.2 * 1024 * 1024 * 1024",
                      "duration":  300,
                      "keepFiringFor":  0,
                      "labels":  {
                                     "severity":  "info",
                                     "tier":  "t1"
                                 },
                      "annotations":  {
                                          "description":  "195 本机 MemAvailable={{ $value | humanize1024 }}，跌破 tier1 闸门 1.2GiB 且持续 5m。属早期预警，仅需关注新增内存消耗来源。",
                                          "summary":  "HOST1 可用内存低于 1.2GiB（tier1/info）"
                                      },
                      "alerts":  [

                                 ],
                      "health":  "ok",
                      "evaluationTime":  0.000256173,
                      "lastEvaluation":  "2026-09-09T08:18:23.95300886Z",
                      "type":  "alerting"
                  },
                  {
                      "state":  "inactive",
                      "name":  "MemoryGateTier2",
