# Agent 模型接入（阿里云百炼 OpenAI 兼容模式）
# 注意：Spring AI 会自动拼 /v1/chat/completions，base-url 不要带 /v1 尾段，
# 否则拼出 /compatible-mode/v1/v1/chat/completions → 404
OPENAI_COMPAT_BASE_URL=https://ws-o2y5qf6ggzjw2loj.cn-beijing.maas.aliyuncs.com/compatible-mode
AGENT_MODEL_API_KEY=__填真实的_key__
# 模型选型：qwen 系列或 deepseek 系列，如 qwen-plus / deepseek-v3
AGENT_MODEL=qwen-plus

# CAS 落盘目录（可选，默认 ./var/cas）
# APP_CAS_DIR=./var/cas

# GitHub 只读 token（本地手动联调 fallback：EnvCredentialTokenPort/EnvCredentialBroker 用；
# 正式路径是 Publisher CredentialBroker 铸造，T14 已就位）
# GITHUB_READONLY_TOKEN=__github_pat_只读__
# GITHUB_WRITE_TOKEN=__github_pat_写___

# --- docker 栈（T18 compose）必填 ---
# GitHub App 凭证（Publisher 独占；私钥文件只读挂载，路径默认 /run/secrets/github-app-key.pem）
# GITHUB_APP_ID=__app_id__
# GITHUB_INSTALLATION_ID=__installation_id__
# GITHUB_APP_KEY_PATH=/run/secrets/github-app-key.pem
# 铸造 token 时收窄到的仓库名（逗号分隔；空 = installation 全域）
# GITHUB_MINT_REPOSITORIES=repo-a
# Control↔Publisher 只读 token 窄接口共享密钥（两边必须一致，X-Internal-Token 头）
# INTERNAL_TOKEN_SECRET=__随机长串__
# Control 侧窄接口地址（compose 内网别名）
# PUBLISHER_TOKEN_ENDPOINT=http://publisher:8081

# --- docker 栈（T18 compose）追加变量，deploy/.env 用 ---
# postgres 超级用户密码（仅 migrate one-shot 与 initdb 用，业务容器不持有）
# POSTGRES_PASSWORD=__随机长串__
# POSTGRES_DB=pr_agent
# 应用角色密码（control_app / publisher_app，initdb 角色脚本读取）
# CONTROL_DB_PASSWORD=__随机长串__
# PUBLISHER_DB_PASSWORD=__随机长串__
# webhook 验签密钥（control，fail-closed 必填）
# GITHUB_WEBHOOK_SECRET=__随机长串__
# GitHub API base：stub 模式默认 http://github-stub:8080（compose 已内置默认），
# 接真实 GitHub 时改为 https://api.github.com 并移除 github-stub 服务
# GITHUB_API_BASE=http://github-stub:8080
# 宿主机端口（均可不填）：control webhook 仅绑 127.0.0.1
# CONTROL_PORT=8080
# STUB_ADMIN_PORT=19090
