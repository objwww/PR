# Agent 模型接入（阿里云百炼 OpenAI 兼容模式；AM1 期 HolmesGPT 自用，AM4 Java 替换时 control 直接用）
# 注意：Spring AI 会自动拼 /v1/chat/completions，base-url 不要带 /v1 尾段，
# 否则拼出 /compatible-mode/v1/v1/chat/completions → 404
OPENAI_COMPAT_BASE_URL=https://ws-o2y5qf6ggzjw2loj.cn-beijing.maas.aliyuncs.com/compatible-mode
AGENT_MODEL_API_KEY=__填真实的_key__
AGENT_MODEL=glm-5

# CAS 落盘目录（可选，默认 ./var/cas）
# APP_CAS_DIR=./var/cas

# --- AM1 告警链路（docker 栈） ---
# Alertmanager → control-app webhook 的 bearer 凭证（两边一致）
# 键名与 application.yml / AlertSelfCheck 三方统一（BA-09①，G0-02）
# ALERTMANAGER_WEBHOOK_BEARER_TOKEN=__随机长串__
# M6-07 Holmes 退场：HOLMES_BASE_URL/HOLMES_API_KEY/APP_ALERT_HOLMES_MODEL 等键随
# 服务摘除回收（历史形态见 git tag pre-holmes-removal）；litellm 链键保留（C-63）

# AM5 M5-04：采样指纹 provider 身份（部署特定=模型由谁服务；INV-AM5-3 fail-closed，
# compose :? 必填——不配置 control-app 启动即失败）
# APP_ALERT_EVAL_PROVIDER_FINGERPRINT=litellm:glm-5@dashscope
# AM5 M5-09 ConfigBundle 发布/回滚 API 的 bearer 凭证（release 角色共享凭证；
# O-4 用户体系落地前形态，compose :? 必填）
# APP_RELEASE_API_BEARER=__随机长串__

# AM5 M5-12 Operator Case API 的 bearer 凭证（operator 角色共享凭证；同 O-4 形态，
# compose :? 必填）
# APP_OPERATOR_API_BEARER=__随机长串__

# AM5 M5-16 控制面合成告警通道 bearer（Gatus/控制面自监控经三面门直达值班通道；
# 与 ALERTMANAGER_WEBHOOK_BEARER_TOKEN 相互独立，compose :? 必填）
# CONTROL_WEBHOOK_BEARER_TOKEN=__随机长串__

# AM6 M6-01 NATIVE 执行面（capability 探针依赖；两键空 = 缺件 → NATIVE_DEFERRED，
# 路由面降级 HOLMES——C-67 无热开关，装配变更只经重启生效；canary 放量前必须落真值）
# 症状指标数据源（F1 冻结规则的真实数据源，与 Am4ShadowTrigger.METRICS_EXPR 同域）
# APP_ALERT_NATIVE_METRICS_EXPR=oa_duplicate_orders_current{job="order-arena"}
# 工具注册面 digest（快照身份面；工具集变更即新身份）
# APP_ALERT_NATIVE_TOOL_REGISTRY_DIGEST=am6-native:prometheus.query,logs.query,change.query

# AM5 M5-15 遥测上游独立出口/独立凭据（otelcol-control → 上级 collector/后端；
# 与 webhook/DB/模型凭据全独立，compose :? 必填）
# OTEL_UPSTREAM_ENDPOINT=__上级 collector 地址:4317__
# OTEL_UPSTREAM_TOKEN=__随机长串__
# OTEL_UPSTREAM_INSECURE=true
# 应用侧 trace 采样概率第一道面（collector 侧 tail_sampling 错误/慢全保，健康 10%）
# APP_TRACE_SAMPLING=0.1

# --- docker 栈 compose 必填（deploy/.env 用） ---
# postgres 超级用户密码（仅 migrate one-shot 与 initdb 用，业务容器不持有）
# POSTGRES_PASSWORD=__随机长串__
# POSTGRES_DB=pr_agent
# 应用角色密码（control_app / publisher_app，initdb 角色脚本读取；
# publisher_app 角色仅为 V2~V6 历史授权对象保留，V7 起显式 REVOKE，无服务使用）
# CONTROL_DB_PASSWORD=__随机长串__
# PUBLISHER_DB_PASSWORD=__随机长串__
# AM2 arena 三角色（M2-03：arena_app / chaos_admin_app / eval_app，initdb 角色脚本读取；
# 存量库角色由 arena 域 V1 迁移的幂等 DO 块补齐）
# ARENA_DB_PASSWORD=__随机长串__
# CHAOS_ADMIN_DB_PASSWORD=__随机长串__
# EVAL_DB_PASSWORD=__随机长串__
# AM3 notify_app（M3-03/V9：角色由 V9 迁移幂等创建，不经 01-roles.sh 提前建；
# migrate one-shot 以 FLYWAY_PLACEHOLDERS_NOTIFY_PASSWORD 注入）
# NOTIFY_DB_PASSWORD=__随机长串__
# 宿主机端口（均可不填）：control webhook 仅绑 127.0.0.1，公网零暴露
# CONTROL_PORT=8080

# --- AM2 订单靶场（deploy/alert/.env 用） ---
# chaos 管理面独立凭证（eval-mgmt 私网 + token 双重边界）
# CHAOS_ADMIN_TOKEN=__随机长串__
# order-arena 业务 API 宿主端口（仅绑 127.0.0.1；可不填默认 8081）
# ARENA_PORT=8081
# 有界流量发生器开关（docker 栈内默认 true）
# TRAFFIC_ENABLED=true
